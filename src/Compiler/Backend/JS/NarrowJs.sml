(* Runtime names shared by the two JavaScript emitters. *)
structure NarrowJs =
struct
  (* Runtime exceptions have stable fields independent of the name supply. *)
  fun predefinedExcon e =
      Option.map #2 (List.find (fn (source,_) => Excon.eq (source,e))
        [(Excon.ex_BIND,"Bind"),(Excon.ex_MATCH,"Match"),(Excon.ex_DIV,"Div"),
         (Excon.ex_OVERFLOW,"Overflow"),(Excon.ex_SUBSCRIPT,"Subscript"),
         (Excon.ex_SIZE,"Size"),(Excon.ex_INTERRUPT,"Interrupt")])
  val primitives = [
    ("floorFloatWide","Math.floor"),
    ("ceilFloatWide","Math.ceil"),
    ("truncFloatWide","SmlPrims.trunc"),
    ("__plus_real16","SmlPrims.real16_add"),
    ("__minus_real16","SmlPrims.real16_sub"),
    ("__mul_real16","SmlPrims.real16_mul"),
    ("__div_real16","SmlPrims.real16_div"),
    ("__neg_real16","SmlPrims.real16_neg"),
    ("__abs_real16","SmlPrims.real16_abs"),
    ("__sqrt_real16","SmlPrims.real16_sqrt"),
    ("__less_real16","SmlPrims.real16_less"),
    ("__lesseq_real16","SmlPrims.real16_lesseq"),
    ("__greater_real16","SmlPrims.real16_greater"),
    ("__greatereq_real16","SmlPrims.real16_greatereq"),
    ("__equal_real16","SmlPrims.real16_equal"),
    ("__unequal_real16","SmlPrims.real16_unequal"),
    ("__int_to_real16","SmlPrims.real16_from"),
    ("__plus_real32","SmlPrims.real32_add"),
    ("__minus_real32","SmlPrims.real32_sub"),
    ("__mul_real32","SmlPrims.real32_mul"),
    ("__div_real32","SmlPrims.real32_div"),
    ("__neg_real32","SmlPrims.real32_neg"),
    ("__abs_real32","SmlPrims.real32_abs"),
    ("__sqrt_real32","SmlPrims.real32_sqrt"),
    ("__less_real32","SmlPrims.real32_less"),
    ("__lesseq_real32","SmlPrims.real32_lesseq"),
    ("__greater_real32","SmlPrims.real32_greater"),
    ("__greatereq_real32","SmlPrims.real32_greatereq"),
    ("__equal_real32","SmlPrims.real32_equal"),
    ("__unequal_real32","SmlPrims.real32_unequal"),
    ("__int_to_real32","SmlPrims.real32_from"),
    ("__real32_to_f64","SmlPrims.real32_to"),
    ("__f64_to_real32","SmlPrims.real32_from"),
    ("@mlkit_real16_to_double","SmlPrims.real16_to"),
    ("@mlkit_double_to_real16","SmlPrims.real16_from"),
    ("mlkit_real16_ldexp","SmlPrims.real16_ldexp"),
    ("mlkit_real16_rem","SmlPrims.real16_rem"),
    ("@fmodf","SmlPrims.real32_rem"),
    ("@nextafterf","SmlPrims.real32_next"),
    ("@ldexpf","SmlPrims.real32_ldexp"),
    ("floatSetRoundingMode","SmlPrims.narrow.setMode"),
    ("floatGetRoundingMode","SmlPrims.narrow.getMode"),
    ("narrowWideRound","SmlPrims.narrowWideRound"),
    ("narrowWideFrexp","SmlPrims.narrowWideFrexp"),
    ("narrowIntegerString","SmlPrims.narrowIntegerString"),
    ("allocStringML","SmlPrims.narrowAlloc"),
    ("__bytetable_sub_word16","SmlPrims.narrowSub16"),
    ("__bytetable_update_word16","SmlPrims.narrowUpdate16"),
    ("__bytetable_sub_real32","SmlPrims.narrowSub32"),
    ("__bytetable_update_real32","SmlPrims.narrowUpdate32"),
    ("@sinf","SmlPrims.real32_sin"),
    ("@sin","Math.sin"),
    ("@cosf","SmlPrims.real32_cos"),
    ("@cos","Math.cos"),
    ("@tanf","SmlPrims.real32_tan"),
    ("@tan","Math.tan"),
    ("@asinf","SmlPrims.real32_asin"),
    ("@asin","Math.asin"),
    ("@acosf","SmlPrims.real32_acos"),
    ("@acos","Math.acos"),
    ("@atanf","SmlPrims.real32_atan"),
    ("@atan","Math.atan"),
    ("@atan2f","SmlPrims.real32_atan2"),
    ("@atan2","Math.atan2"),
    ("@expf","SmlPrims.real32_exp"),
    ("@exp","Math.exp"),
    ("@logf","SmlPrims.real32_log"),
    ("@log","Math.log"),
    ("@log10f","SmlPrims.real32_log10"),
    ("@log10","Math.log10"),
    ("@sinhf","SmlPrims.real32_sinh"),
    ("@sinh","SmlPrims.sinh"),
    ("@coshf","SmlPrims.real32_cosh"),
    ("@cosh","SmlPrims.cosh"),
    ("@tanhf","SmlPrims.real32_tanh"),
    ("@tanh","SmlPrims.tanh"),
    ("@powf","SmlPrims.real32_pow"),
    ("@pow","Math.pow"),
    ("@floorf","SmlPrims.real32_floor"),
    ("@floor","Math.floor"),
    ("@ceilf","SmlPrims.real32_ceil"),
    ("@ceil","Math.ceil"),
    ("@truncf","SmlPrims.real32_trunc"),
    ("@trunc","SmlPrims.trunc")]
  fun lookup name =
      Option.map #2 (List.find (fn (source,_) => source = name) primitives)
end
