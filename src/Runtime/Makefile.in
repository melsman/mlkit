# Runtime artifacts are isolated by configured target and runtime variant.
.DEFAULT_GOAL := all
CC=@CC@
CFLAGS=@CFLAGS@
CPPFLAGS=@CPPFLAGS@
DARWIN_NATIVE=@DARWIN_NATIVE@
RUNTIME_TARGET=@RUNTIME_TARGET@
ARGOBOTS_ROOT=@ARGOBOTS_ROOT@
INSTALL=@INSTALL@
INSTALLDATA=@INSTALL_DATA@
MKDIR=@top_srcdir@/mkinstalldirs
BUILD=build/$(RUNTIME_TARGET)
LIBDIR=@top_srcdir@/lib/$(RUNTIME_TARGET)
LEGACY_LIBDIR=@top_srcdir@/lib
OPT=-Wall -std=gnu99 -fPIC $(CPPFLAGS) $(CFLAGS) -iquote . -I$(BUILD) -include Target.h
AR=ar

# A make override must not silently disagree with config.h or the compiler.
ifneq ($(DARWIN_NATIVE),@DARWIN_NATIVE@)
$(error Set DARWIN_NATIVE when running configure, not make)
endif
ifneq ($(RUNTIME_TARGET),@RUNTIME_TARGET@)
$(error RUNTIME_TARGET is selected by configure)
endif

SOURCES=Runtime IO String Math Region Icp Table Time Profiling CommandLine \
        Posix Dlsym Export Socket Repl Layout
COMMON=$(addsuffix .c,$(SOURCES)) ../CUtils/hashmap.c ../CUtils/hashmap_typed.c
VARIANTS=plain tag prof gc gcprof gengc gengcprof gctp gctpprof par
ALL_OBJECTS=
ARCHIVES=

# Each variant gets its own generated header dependencies and object directory.
# Public archive targets also refresh the compatibility copies on every request.
define variant
OBJECTS_$(1)=$$(addprefix $$(BUILD)/$(1)/,$$(notdir $$(patsubst %.c,%.o,$(3))))
ALL_OBJECTS+=$$(OBJECTS_$(1))
ARCHIVES+=$(2)
$$(BUILD)/$(1)/%.o: %.c Makefile Target.h config.h | $$(BUILD)/SysErrTable.h
	@mkdir -p $$(@D)
	$$(CC) $$(OPT) $(4) -MMD -MP -c $$< -o $$@
$$(BUILD)/$(1)/%.o: ../CUtils/%.c Makefile Target.h config.h | $$(BUILD)/SysErrTable.h
	@mkdir -p $$(@D)
	$$(CC) $$(OPT) $(4) -MMD -MP -c $$< -o $$@
$$(BUILD)/$(2): $$(OBJECTS_$(1))
	rm -f $$@
	$$(AR) rc $$@ $$^
.PHONY: $(2)
$(2): $$(BUILD)/$(2)
	$$(MKDIR) $$(LIBDIR)
	$$(INSTALLDATA) $$< $$(LIBDIR)/$(2)
ifeq ($$(DARWIN_NATIVE),0)
	$$(INSTALLDATA) $$< $$(LEGACY_LIBDIR)/$(2)
endif
endef

$(eval $(call variant,plain,runtimeSystem.a,$(COMMON),))
$(eval $(call variant,tag,runtimeSystemTag.a,$(COMMON),-DTAG_VALUES -DTAG_FREE_PAIRS))
$(eval $(call variant,prof,runtimeSystemProf.a,$(COMMON),-DPROFILING))
$(eval $(call variant,gc,runtimeSystemGC.a,$(COMMON) GC.c,-DTAG_VALUES -DTAG_FREE_PAIRS -DENABLE_GC))
$(eval $(call variant,gcprof,runtimeSystemGCProf.a,$(COMMON) GC.c,-DTAG_VALUES -DTAG_FREE_PAIRS -DENABLE_GC -DPROFILING))
$(eval $(call variant,gengc,runtimeSystemGenGC.a,$(COMMON) GC.c,-DTAG_VALUES -DTAG_FREE_PAIRS -DENABLE_GC -DENABLE_GEN_GC))
$(eval $(call variant,gengcprof,runtimeSystemGenGCProf.a,$(COMMON) GC.c,-DTAG_VALUES -DTAG_FREE_PAIRS -DENABLE_GC -DENABLE_GEN_GC -DPROFILING))
$(eval $(call variant,gctp,runtimeSystemGCTP.a,$(COMMON) GC.c,-DTAG_VALUES -DENABLE_GC))
$(eval $(call variant,gctpprof,runtimeSystemGCTPProf.a,$(COMMON) GC.c,-DTAG_VALUES -DENABLE_GC -DPROFILING))
$(eval $(call variant,par,runtimeSystemPar.a,$(COMMON) Spawn.c,-DPARALLEL))
DEFAULT_ARCHIVES:=$(ARCHIVES)
$(eval $(call variant,arpar,runtimeSystemArPar.a,$(COMMON) Spawn.c,-DARGOBOTS -DPARALLEL -I$(ARGOBOTS_ROOT)/src/include))

.PHONY: all runtime clean
all runtime: $(DEFAULT_ARCHIVES)

$(BUILD)/gen_syserror: gen_syserror.c Makefile Target.h config.h
	@mkdir -p $(@D)
	$(CC) $(OPT) $< -o $@

$(BUILD)/SysErrTable.h: $(BUILD)/gen_syserror
	$< > $@.tmp
	mv $@.tmp $@

clean:
	rm -rf $(BUILD)

-include $(ALL_OBJECTS:.o=.d)
