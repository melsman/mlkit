# ARM64 compilers, built with an existing native MLKit on macOS.
.DEFAULT_GOAL := all
.NOTPARALLEL:
MLKIT_BOOTSTRAP ?= mlkit
# Use the bootstrap compiler's installed Basis and matching runtime, even when
# SML_LIB points at this checkout for subsequent native compilation.
# Override this for an unpacked seed without an installed mlb-path-map.
MLKIT_BOOTSTRAP_SML_LIB ?=
BOOTSTRAP_ENV = $(if $(strip $(MLKIT_BOOTSTRAP_SML_LIB)),env SML_LIB="$(MLKIT_BOOTSTRAP_SML_LIB)",env -u SML_LIB)
ifeq ($(shell uname -s),Darwin)
# Reserve a larger stack for self-compilation; the ARM64 linker allows at most 512 MiB.
MLKIT_BOOTSTRAP_FLAGS ?= -ldexe 'gcc -arch arm64 -Wl,-stack_size,0x20000000'
else
MLKIT_BOOTSTRAP_FLAGS ?=
endif
SML_LIB ?= $(CURDIR)

.PHONY: all mlkit reml smltojs emitter configuration check
all: mlkit reml
configuration:
	$(MAKE) -C src/Tools/MlbMake Configuration.sml
	@test -f src/Version.sml || (echo 'Run configure before building the compiler' >&2; exit 1)
	mkdir -p bin
mlkit: configuration
	$(BOOTSTRAP_ENV) "$(MLKIT_BOOTSTRAP)" $(MLKIT_BOOTSTRAP_FLAGS) -o bin/mlkit-arm64 src/Compiler/mlkitarm64.mlb
reml: configuration
	$(BOOTSTRAP_ENV) "$(MLKIT_BOOTSTRAP)" $(MLKIT_BOOTSTRAP_FLAGS) -o bin/reml-arm64 src/Compiler/remlarm64.mlb
smltojs: configuration
	$(BOOTSTRAP_ENV) "$(MLKIT_BOOTSTRAP)" $(MLKIT_BOOTSTRAP_FLAGS) -o bin/smltojs src/Compiler/smltojs.mlb
emitter: configuration
	$(BOOTSTRAP_ENV) "$(MLKIT_BOOTSTRAP)" $(MLKIT_BOOTSTRAP_FLAGS) -o bin/arm64-emitter-test src/Compiler/Backend/Arm64/tests/emitter.mlb
check: all emitter
	ARM64_EMITTER="$(CURDIR)/bin/arm64-emitter-test" SML_LIB="$(SML_LIB)" MLKIT_ARM64="$(CURDIR)/bin/mlkit-arm64" REML_ARM64="$(CURDIR)/bin/reml-arm64" sh src/Compiler/Backend/Arm64/tests/check-native.sh
	SML_LIB="$(SML_LIB)" MLKIT_ARM64="$(CURDIR)/bin/mlkit-arm64" REML_ARM64="$(CURDIR)/bin/reml-arm64" sh src/Compiler/Backend/Arm64/tests/check-parallel.sh
	SML_LIB="$(SML_LIB)" MLKIT_ARM64="$(CURDIR)/bin/mlkit-arm64" sh src/Compiler/Backend/Arm64/tests/check-switches.sh

# The low-level targets keep their outputs separate. The configured top-level
# native build publishes them under the usual bin names through `build`.
ARM64_COMPILER ?= $(MLKIT_BOOTSTRAP)
ARM64_NATIVE_BIN ?= $(CURDIR)/bin/darwin-arm64
ARM64_BUILD ?= $(CURDIR)/src/Tools/Rp2ps/build/darwin-arm64
ARM64_PREFIX ?= $(SML_LIB)/stage/darwin-arm64

.PHONY: native native-tools bootstrap native-install regressions
native: configuration
	mkdir -p "$(ARM64_NATIVE_BIN)"
	$(BOOTSTRAP_ENV) "$(ARM64_COMPILER)" $(MLKIT_BOOTSTRAP_FLAGS) -o "$(ARM64_NATIVE_BIN)/mlkit" src/Compiler/mlkitarm64.mlb
	$(BOOTSTRAP_ENV) "$(ARM64_COMPILER)" $(MLKIT_BOOTSTRAP_FLAGS) -o "$(ARM64_NATIVE_BIN)/reml" src/Compiler/remlarm64.mlb
native-tools: configuration
	mkdir -p "$(ARM64_NATIVE_BIN)" "$(ARM64_BUILD)"
	$(BOOTSTRAP_ENV) "$(ARM64_COMPILER)" $(MLKIT_BOOTSTRAP_FLAGS) -o "$(ARM64_NATIVE_BIN)/kittester" src/Tools/Tester/KitTester.mlb
	$(BOOTSTRAP_ENV) "$(ARM64_COMPILER)" $(MLKIT_BOOTSTRAP_FLAGS) -o "$(ARM64_NATIVE_BIN)/mlkit-mllex" src/Tools/ml-lex/ml-lex.mlb
	$(BOOTSTRAP_ENV) "$(ARM64_COMPILER)" $(MLKIT_BOOTSTRAP_FLAGS) -o "$(ARM64_NATIVE_BIN)/mlkit-mlyacc" src/Tools/ml-yacc/src/ml-yacc.mlb
	gcc -arch arm64 -O2 -Wall -std=gnu99 src/Tools/Rp2ps/*.c -lm -o "$(ARM64_BUILD)/rp2ps"
	cp "$(ARM64_BUILD)/rp2ps" "$(ARM64_NATIVE_BIN)/rp2ps"
bootstrap:
	SML_LIB="$(SML_LIB)" BOOTSTRAP_COMPILER="$(ARM64_NATIVE_BIN)/mlkit" sh src/Compiler/Backend/Arm64/tests/check-bootstrap.sh
native-install:
	SML_LIB="$(SML_LIB)" ARM64_NATIVE_BIN="$(ARM64_NATIVE_BIN)" ARM64_PREFIX="$(ARM64_PREFIX)" sh src/Compiler/Backend/Arm64/tests/install-native.sh
regressions:
	SML_LIB="$(SML_LIB)" MLKIT_ARM64="$(ARM64_NATIVE_BIN)/mlkit" REML_ARM64="$(ARM64_NATIVE_BIN)/reml" KITTESTER="$(ARM64_NATIVE_BIN)/kittester" sh src/Compiler/Backend/Arm64/tests/check-regressions.sh

# Entry point for the normal Makefile after configuring DARWIN_NATIVE=1.
# Build directly with the installed native seed; no intermediate compiler.
# Keep its library/runtime environment separate from the checkout.
.PHONY: build
build:
	$(MAKE) -f Makefile.arm64 native native-tools
	@set -e; for tool in mlkit reml kittester mlkit-mllex mlkit-mlyacc rp2ps; do \
	  ln -sf "$(abspath $(ARM64_NATIVE_BIN))/$$tool" "bin/$$tool"; \
	done
